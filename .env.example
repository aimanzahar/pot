# Copy to `.env` and set your own values. `.env` is git-ignored.

# Pinggy access token (from https://dashboard.pinggy.io)
# Used by docker-compose's `pinggy` service to open a public tunnel
# to the Next.js app inside the `app` container.
PINGGY_TOKEN=your_pinggy_token_here

# Path prefix the app is served under (e.g. /bill so it lives at
# https://your.a.pinggy.link/bill). Leave empty to serve at root.
# Baked at build time — change requires `docker compose up --build`.
NEXT_PUBLIC_BASE_PATH=/bill

# Origin used to build share links. When set, share links always point
# here, even if the form was submitted from localhost. Should include
# the base path above if used.
PUBLIC_APP_URL=https://your.a.pinggy.link/bill
